DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus_crime
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus_crime
LOG_LEVEL=INFO
DEBUG=true
RISK_WEIGHTS_PATH=configs/risk_weights.yaml
LOGGING_CONFIG_PATH=configs/logging.yaml

# Firebase Auth — Backend Token Verification
# Set to true for local/demo development without a Firebase service account
FIREBASE_VERIFICATION_DISABLED=true
# Path to Firebase service account JSON (required when FIREBASE_VERIFICATION_DISABLED=false)
FIREBASE_SERVICE_ACCOUNT_PATH=
