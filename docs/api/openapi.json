  "paths": {
    "/api/v1/upload/tower-dump": {
      "post": {
        "tags": [
          "Upload"
        ],
        "summary": "Upload a tower dump CSV for a given case",
        "description": "Ingests and validates a tower dump CSV file.\nRejects malformed schemas, unknown tower metadata, and handles duplicate records gracefully.\nTriggers correlation pipeline in background.",
        "operationId": "upload_tower_dump_api_v1_upload_tower_dump_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_tower_dump_api_v1_upload_tower_dump_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
